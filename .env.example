# ── OpenRouter (primary AI provider) ──────────────────────────────
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── OpenRouter Model (choose one) ─────────────────────────────────
# google/gemini-2.5-flash-lite:free     (default — fast, free)
# meta-llama/llama-4-maverick:free      (fallback 1)
# deepseek/deepseek-chat-v3-0324:free   (fallback 2)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite:free

# ── DeepSeek (alternative provider) ───────────────────────────────
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat
# AI_PROVIDER=openrouter

# ── VirusTotal (optional, 70+ engines) ────────────────────────────
# Free API key at https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY=your-key

# ── PhishTank (optional, community DB) ────────────────────────────
# Free API key at https://phishtank.org/register.php
# PHISHTANK_API_KEY=your-key
